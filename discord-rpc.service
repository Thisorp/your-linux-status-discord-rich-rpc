[Unit]
Description=Linux Discord Rich Presence
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/linux-discord-rpc
ExecStart=%h/.local/share/linux-discord-rpc/.venv/bin/python %h/.local/share/linux-discord-rpc/discord_rpc.py
Restart=on-failure
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=graphical-session.target
